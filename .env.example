# SQLite fallback (opsional)
# DATABASE_URL="file:./dev.db"

# PostgreSQL connection strings
# Untuk migrasi DDL / admin:
# DATABASE_URL="postgresql://simpatik_admin:GANTI_PASSWORD_ADMIN@localhost:5432/simpatik_db?schema=public"
# Untuk runtime back-end aplikasi (simpatik_app):
DATABASE_URL="postgresql://simpatik_app:GANTI_PASSWORD_APP@localhost:5432/simpatik_db?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:8443"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
ATTENDANCE_THRESHOLD=75
NILAI_DROP_THRESHOLD=10
SEED_ADMIN_EMAIL="admin@simpatik.local"
SEED_ADMIN_PASSWORD="admin123"
